{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickDoc",
  "version": "0.2.0",
  "identifier": "com.quickdoc.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickDoc",
        "width": 400,
        "height": 800,
        "minWidth": 340,
        "minHeight": 400,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "center": false,
        "x": 0,
        "y": 0
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/attachments/**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "QuickDoc",
    "category": "Utility",
    "shortDescription": "Instant note-taking utility",
    "longDescription": "QuickDoc is a zero-friction, instant note-taking utility that lives in your system tray."
  },
  "plugins": {}
}
